[StarFeedback]

## HapticsAndAudio, HapticsOnly, AudioOnly or Disabled.
# Setting type: StarFeedbackMode
# Default value: HapticsAndAudio
# Acceptable values: HapticsAndAudio, HapticsOnly, AudioOnly, Disabled
Mode = HapticsAndAudio

## Relative to game master/SFX volume: 1=100%, lower values attenuate. Applied once; respects game mute.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 1
SoundVolume = 1

## One local sound pack for all four stars. Unknown/missing pack mutes audio only; restart to discover newly installed packs.
# Setting type: String
# Default value: turbo_swing
SoundPackId = turbo_swing

[Stars]

## First committed-score threshold crossing; no retroactive or final-star guarantee.
# Setting type: Boolean
# Default value: true
Enabled = true
