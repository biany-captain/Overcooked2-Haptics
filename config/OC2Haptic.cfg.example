[Routing]

## Explicit fallback for ordinary delivery/failed/expired team alerts when actor cannot be proven. Never enables guessed Combo or all-controller broadcast.
# Setting type: Boolean
# Default value: false
AllowTeamDeliveryFallback = false

## Explicit campaign team alert fallback when multiple local outputs exist; only the selected binding is used. Single proven output needs no fallback.
# Setting type: Boolean
# Default value: false
AllowTeamHazardFallback = false

[StarFeedback]

## Relative to game master/SFX volume: 1=100%, lower values attenuate. Applied once; respects game mute.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 1
SoundVolume = 1

## One local sound pack for all four stars. Unknown/missing pack mutes audio only; restart to discover newly installed packs.
# Setting type: String
# Default value: turbo_swing
SoundPackId = turbo_swing

## Independent three-star PCM16 WAV; relative to plugin audio folder or an absolute path. Restart after editing. Missing/invalid file mutes only sound.
# Setting type: String
# Default value: user-v1.7/star3_progress.wav
Star3AudioFile = user-v1.7/star3_progress.wav

## Custom four-star PCM16 WAV,9-11s; relative to plugin audio folder or absolute. Restart after editing.
# Setting type: String
# Default value: user-v1.7/star4_victory.wav
Star4AudioFile = user-v1.7/star4_victory.wav

## Custom four-star file or an existing pack ID. Legacy pack music retains its original shorter duration. Old SoundPackId preference is preserved separately.
# Setting type: String
# Default value: custom-v17
Star4Selection = custom-v17

## Three-star audio multiplier; user approved100% initially, applied once with relative volume.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 1
Star3Volume = 1

## Four-star audio multiplier; user approved100% initially, applied once with relative volume.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 1
Star4Volume = 1

[Stars]

## Automatic star haptics, also subject to the haptic master. Explicit previews remain available.
# Setting type: Boolean
# Default value: true
HapticsEnabled = true

## Automatic star audio, also subject to the audio master. Explicit previews remain available.
# Setting type: Boolean
# Default value: true
AudioEnabled = true

## Automatic milestone only. Explicit previews bypass this switch; stars1/2 can never play audio.
# Setting type: Boolean
# Default value: true
Star1Enabled = true

## Automatic milestone only. Explicit previews bypass this switch; stars1/2 can never play audio.
# Setting type: Boolean
# Default value: true
Star2Enabled = true

## Automatic milestone only. Explicit previews bypass this switch; stars1/2 can never play audio.
# Setting type: Boolean
# Default value: true
Star3Enabled = true

## Automatic milestone only. Explicit previews bypass this switch; stars1/2 can never play audio.
# Setting type: Boolean
# Default value: true
Star4Enabled = true
