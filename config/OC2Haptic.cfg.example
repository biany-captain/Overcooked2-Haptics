[Audio]

## Stop this plugin's feedback on focus loss. Recommended true.
# Setting type: Boolean
# Default value: true
RespectGameFocus = true

[Combo]

## Enable trusted tier feedback; disabling retains ordered/out-of-order classification.
# Setting type: Boolean
# Default value: true
Enabled = true

## EveryOrderedDelivery or OnLevelUp; authoritative game state only.
# Setting type: ComboTriggerMode
# Default value: EveryOrderedDelivery
# Acceptable values: EveryOrderedDelivery, OnLevelUp
TriggerMode = EveryOrderedDelivery

## Haptic ceiling only; raw streak is never truncated.
# Setting type: Int32
# Default value: 4
# Acceptable value range: From 1 to 4
MaxHapticTier = 4

## Additional Combo motor multiplier.
# Setting type: Single
# Default value: 0.85
# Acceptable value range: From 0 to 1
ComboMasterIntensity = 0.85

[Devices]

## Explicit Windows output slot, -1 unbound.
# Setting type: Int32
# Default value: -1
# Acceptable value range: From -1 to 3
XInputIndex = -1

## Actual game pad number, independent of XInput. -1 unbound.
# Setting type: Int32
# Default value: -1
# Acceptable value range: From -1 to 14
LocalGamePadSlot = -1

[Diagnostics]

## Detailed read-only before/payload/after diagnostics; capture required by rewards remains active independently.
# Setting type: Boolean
# Default value: false
ScoreSourceProbe = false

[Events]

## Confirmed local throw feedback.
# Setting type: Boolean
# Default value: true
ThrowSuccess = true

## Candidate two-part catch feedback; current local/host Hook.
# Setting type: Boolean
# Default value: true
CatchSuccess = true

## Rejected delivery, low-motor feedback.
# Setting type: Boolean
# Default value: true
DeliveryFailure = true

## Ordered delivery and its permitted Combo feedback.
# Setting type: Boolean
# Default value: true
DeliveryOrdered = true

## Successful out-of-order delivery, distinct from failure.
# Setting type: Boolean
# Default value: true
DeliveryOutOfOrder = true

## Conservative light success feedback when classification is unavailable.
# Setting type: Boolean
# Default value: true
DeliveryUnclassified = true

## Actual expiry feedback, no advance warning.
# Setting type: Boolean
# Default value: true
OrderExpired = true

[EventStrength]

## Per-event multiplier: 1=100%, range0-200%. Uniformly capped to preserve motor balance and timing.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 2
ThrowSuccess = 1

## Per-event multiplier: 1=100%, range0-200%. Uniformly capped to preserve motor balance and timing.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 2
CatchSuccess = 1

## Per-event multiplier: 1=100%, range0-200%. Uniformly capped to preserve motor balance and timing.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 2
DeliveryFailure = 1

## Per-event multiplier: 1=100%, range0-200%. Uniformly capped to preserve motor balance and timing.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 2
OrderExpired = 1

## Per-event multiplier: 1=100%, range0-200%. Uniformly capped to preserve motor balance and timing.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 2
DeliveryOrdered = 1

## Per-event multiplier: 1=100%, range0-200%. Uniformly capped to preserve motor balance and timing.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 2
DeliveryOutOfOrder = 1

## Per-event multiplier: 1=100%, range0-200%. Uniformly capped to preserve motor balance and timing.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 2
DeliveryUnclassified = 1

## Per-event multiplier: 1=100%, range0-200%. Uniformly capped to preserve motor balance and timing.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 2
ComboLevel2 = 1

## Per-event multiplier: 1=100%, range0-200%. Uniformly capped to preserve motor balance and timing.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 2
ComboLevel3 = 1

## Per-event multiplier: 1=100%, range0-200%. Uniformly capped to preserve motor balance and timing.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 2
ComboLevel4 = 1

## Per-event multiplier: 1=100%, range0-200%. Uniformly capped to preserve motor balance and timing.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 2
StarMilestone1 = 1

## Per-event multiplier: 1=100%, range0-200%. Uniformly capped to preserve motor balance and timing.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 2
StarMilestone2 = 1

## Per-event multiplier: 1=100%, range0-200%. Uniformly capped to preserve motor balance and timing.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 2
StarMilestone3 = 1

## Per-event multiplier: 1=100%, range0-200%. Uniformly capped to preserve motor balance and timing.
# Setting type: Single
# Default value: 1
# Acceptable value range: From 0 to 2
StarMilestone4 = 1

[General]

## Global switch for this plugin's haptics and reward audio.
# Setting type: Boolean
# Default value: true
Enabled = true

## Haptic motor multiplier, independent of audio gain.
# Setting type: Single
# Default value: 0.75
# Acceptable value range: From 0 to 1
MasterIntensity = 0.75

## Log real event routing, classification and reward decisions.
# Setting type: Boolean
# Default value: false
DebugLogEvents = false

