[Audio]

## Stop this plugin's feedback on focus loss. Recommended true.
# Setting type: Boolean
# Default value: true
RespectGameFocus = true

[Combo]

## Verified upgrade feedback only; ordinary success remains independent.
# Setting type: Boolean
# Default value: true
Enabled = true

## Haptic ceiling only; raw streak is never truncated.
# Setting type: Int32
# Default value: 4
# Acceptable value range: From 1 to 4
MaxHapticTier = 4

[Devices]

## Explicit Windows output slot, -1 unbound.
# Setting type: Int32
# Default value: -1
# Acceptable value range: From -1 to 3
XInputIndex = -1

## Actual game pad number, independent of XInput. -1 unbound.
# Setting type: Int32
# Default value: -1
# Acceptable value range: From -1 to 14
LocalGamePadSlot = -1

[Diagnostics]

## Detailed read-only before/payload/after diagnostics; capture required by rewards remains active independently.
# Setting type: Boolean
# Default value: false
ScoreSourceProbe = false

[Events]

## Automatic candidate feedback. Explicit tests bypass this event switch but always obey channel masters. Unverified hooks are not acceptance.
# Setting type: Boolean
# Default value: false
ThrowSuccess = false

## Automatic candidate feedback. Explicit tests bypass this event switch but always obey channel masters. Unverified hooks are not acceptance.
# Setting type: Boolean
# Default value: false
CatchSuccess = false

## Automatic candidate feedback. Explicit tests bypass this event switch but always obey channel masters. Unverified hooks are not acceptance.
# Setting type: Boolean
# Default value: true
DeliveryFailure = true

## Automatic candidate feedback. Explicit tests bypass this event switch but always obey channel masters. Unverified hooks are not acceptance.
# Setting type: Boolean
# Default value: true
OrderExpired = true

## Automatic candidate feedback. Explicit tests bypass this event switch but always obey channel masters. Unverified hooks are not acceptance.
# Setting type: Boolean
# Default value: true
DeliveryOrdered = true

## Automatic candidate feedback. Explicit tests bypass this event switch but always obey channel masters. Unverified hooks are not acceptance.
# Setting type: Boolean
# Default value: true
DeliveryOutOfOrder = true

## Automatic candidate feedback. Explicit tests bypass this event switch but always obey channel masters. Unverified hooks are not acceptance.
# Setting type: Boolean
# Default value: true
DeliveryUnclassified = true

## Automatic candidate feedback. Explicit tests bypass this event switch but always obey channel masters. Unverified hooks are not acceptance.
# Setting type: Boolean
# Default value: true
BurnWarning = true

## Automatic candidate feedback. Explicit tests bypass this event switch but always obey channel masters. Unverified hooks are not acceptance.
# Setting type: Boolean
# Default value: false
FoodBurned = false

## Automatic candidate feedback. Explicit tests bypass this event switch but always obey channel masters. Unverified hooks are not acceptance.
# Setting type: Boolean
# Default value: true
FireStart = true

## Automatic candidate feedback. Explicit tests bypass this event switch but always obey channel masters. Unverified hooks are not acceptance.
# Setting type: Boolean
# Default value: true
FireReminder = true

[General]

## Log real event routing, classification and reward decisions.
# Setting type: Boolean
# Default value: false
DebugLogEvents = false

## Haptic motor multiplier, independent of audio gain.
# Setting type: Single
# Default value: 0.75
# Acceptable value range: From 0 to 1
MasterIntensity = 0.75

## Master switch for all haptics, including explicit tests. Independent of audio.
# Setting type: Boolean
# Default value: true
HapticsEnabled = true

## Master switch for reward audio, including explicit tests. Follows game master/SFX volume.
# Setting type: Boolean
# Default value: true
AudioEnabled = true

[Hazards]

## Automatic burn-warning, burned and fire haptics as a group. Individual Events switches still apply; excludes rejected/expired orders. Explicit previews remain available.
# Setting type: Boolean
# Default value: true
HapticsEnabled = true

[Hotkeys]

