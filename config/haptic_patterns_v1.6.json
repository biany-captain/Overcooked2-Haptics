{
  "version": "1.6-candidate",
  "status": "proposed; not yet validated in Overcooked2 or on physical controllers",
  "previous_version": "1.5",
  "decision": "Combo mode A: vibrate special pattern ONLY when a verified Combo tier upgrades; otherwise ordinary success uses a single crisp pulse",
  "units": "ms; left/right normalized XInput motor speed commands 0..1, not physical frequency or perceived loudness",
  "settings": {
    "default_preset": "balanced_extended_negative",
    "master_gain": 0.75,
    "per_motor_gain": {"left_low": 1.0, "right_high": 1.0},
    "merge_window_ms": 80,
    "max_total_pattern_ms": 950,
    "normal_active_budget_ms_per_10s": 1200,
    "negative_active_budget_ms_per_10s": 2200,
    "emergency_active_budget_ms_per_10s": 2500,
    "max_same_fire_reminder_interval_ms": 5000,
    "drop_stale_normal_event_after_ms": 180,
    "no_queueing_on_preemption": true,
    "disable_on_pause_or_focus_loss": true,
    "unknown_player_action_routing": "drop_unmapped_personal_event",
    "default_disabled_events": ["pickup", "putdown", "walking", "chopping_per_hit", "cooking_tick"]
  },
  "presets": {
    "balanced_extended_negative": {
      "duration_scale": {"positive": 1.0, "combo": 1.0, "neutral": 1.0, "negative": 1.0, "emergency": 1.0},
      "peak_scale": 1.0
    },
    "quiet": {
      "duration_scale": {"positive": 0.95, "combo": 1.0, "neutral": 0.85, "negative": 0.85, "emergency": 0.9},
      "peak_scale": 0.85
    },
    "dramatic_negative_optional": {
      "duration_scale": {"positive": 1.0, "combo": 1.0, "neutral": 1.0, "negative": 1.22, "emergency": 1.07},
      "peak_scale": 1.0
    }
  },
  "events": {
    "delivery_success": {
      "enabled": true, "category": "positive", "priority": 55, "cooldown_ms": 300,
      "meaning": "Accepted delivery; if combo upgrade / star milestone verified this cue is replaced, not appended",
      "steps": [{"ms": 90, "low": 0.02, "high": 0.72}]
    },
    "delivery_out_of_order": {
      "enabled": true, "category": "neutral", "priority": 63, "cooldown_ms": 600,
      "meaning": "Accepted delivery, verified break of previously active combo; NOT a rejected delivery",
      "steps": [{"ms": 125, "low": 0.29, "high": 0.02}, {"ms": 90, "low": 0, "high": 0}, {"ms": 100, "low": 0.17, "high": 0}]
    },
    "delivery_rejected": {
      "enabled": true, "category": "negative", "priority": 80, "cooldown_ms": 1200,
      "meaning": "Dish was actually rejected; heavier continuous low-motor 'thud with fading tail'",
      "steps": [{"ms": 210, "low": 0.72, "high": 0.02}, {"ms": 95, "low": 0.47, "high": 0}, {"ms": 125, "low": 0.24, "high": 0}]
    },
    "combo_x2_upgrade": {
      "enabled": true, "category": "combo", "priority": 68, "cooldown_ms": 650,
      "meaning": "ONLY authoritative upgrade to 2; replaces delivery_success",
      "steps": [{"ms": 70, "low": 0, "high": 0.49}, {"ms": 70, "low": 0, "high": 0}, {"ms": 95, "low": 0, "high": 0.66}]
    },
    "combo_x3_upgrade": {
      "enabled": true, "category": "combo", "priority": 68, "cooldown_ms": 650,
      "meaning": "ONLY authoritative upgrade to 3; replaces delivery_success",
      "steps": [{"ms": 65, "low": 0, "high": 0.47}, {"ms": 65, "low": 0, "high": 0}, {"ms": 70, "low": 0, "high": 0.55}, {"ms": 65, "low": 0, "high": 0}, {"ms": 110, "low": 0, "high": 0.72}]
    },
    "combo_x4_upgrade": {
      "enabled": true, "category": "combo", "priority": 68, "cooldown_ms": 700,
      "meaning": "ONLY authoritative upgrade to tier 4; after cap no repeated x4 fanfare",
      "steps": [{"ms": 60, "low": 0, "high": 0.47}, {"ms": 60, "low": 0, "high": 0}, {"ms": 60, "low": 0, "high": 0.55}, {"ms": 60, "low": 0, "high": 0}, {"ms": 60, "low": 0, "high": 0.62}, {"ms": 60, "low": 0, "high": 0}, {"ms": 130, "low": 0.12, "high": 0.79}]
    },
    "order_expired": {
      "enabled": true, "category": "negative", "priority": 83, "cooldown_ms": 1800,
      "meaning": "A real order timed out, not merely approaching expiration",
      "steps": [{"ms": 190, "low": 0.61, "high": 0.02}, {"ms": 85, "low": 0, "high": 0}, {"ms": 230, "low": 0.55, "high": 0}]
    },
    "burn_warning": {
      "enabled": true, "category": "emergency", "priority": 92, "cooldown_ms": 5000,
      "meaning": "Enter verified near-burning threshold once; fire takes precedence",
      "steps": [{"ms": 150, "low": 0.44, "high": 0.09}, {"ms": 120, "low": 0, "high": 0}, {"ms": 180, "low": 0.52, "high": 0.09}]
    },
    "food_burned": {
      "enabled": false, "category": "negative", "priority": 88, "cooldown_ms": 2500,
      "meaning": "Optional ONLY once a distinct verified burned-food event exists; disabled until then",
      "steps": [{"ms": 230, "low": 0.66, "high": 0}, {"ms": 90, "low": 0.45, "high": 0}, {"ms": 150, "low": 0.23, "high": 0}]
    },
    "fire_start": {
      "enabled": true, "category": "emergency", "priority": 100, "cooldown_ms": 5000,
      "meaning": "Fire state rising edge; once per incident, preempt, no continuous motor drive",
      "steps": [{"ms": 260, "low": 0.81, "high": 0.10}, {"ms": 90, "low": 0, "high": 0}, {"ms": 310, "low": 0.69, "high": 0.06}, {"ms": 160, "low": 0.30, "high": 0}]
    },
    "fire_reminder": {
      "enabled": true, "category": "emergency", "priority": 95, "cooldown_ms": 5000,
      "meaning": "Only while fire still exists, max once per 5 sec, configurable off; immediately stop on fire cleared",
      "steps": [{"ms": 160, "low": 0.42, "high": 0.08}, {"ms": 130, "low": 0, "high": 0}, {"ms": 180, "low": 0.42, "high": 0.08}]
    },
    "throw": {"enabled": false, "category": "positive", "priority": 20, "cooldown_ms": 270, "steps": [{"ms": 75, "low": 0.06, "high": 0.33}]},
    "catch": {"enabled": false, "category": "positive", "priority": 20, "cooldown_ms": 300, "steps": [{"ms": 65, "low": 0, "high": 0.32}, {"ms": 60, "low": 0, "high": 0}, {"ms": 80, "low": 0, "high": 0.39}]},
    "star_milestone": {"enabled": true, "category": "combo", "priority": 86, "note": "Continue existing 1..4 star celebration pattern and music; do not add successful-delivery / combo cue for same event"}
  },
  "routing": {
    "personal_actions": "known_local_owner_controller_only",
    "delivery_feedback": "verified_delivering_player_else_selectable_team_fallback_no_auto_broadcast",
    "combo_feedback": "verified_delivering_player_else_no_guess",
    "fire_feedback": "verified_relevant_local_players_else_explicit_team_alert_setting_only",
    "star_feedback": "all_local_controllers_once_per_team",
    "backend_priority": ["XInput", "SDL3_when_enabled_and_deduplicated", "SteamInput_optional_verified"],
    "exclusive_per_physical_device": true
  }
}
