<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/OC2Haptic.Plugin/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../src/OC2Haptic.Plugin/XInput/XInputBackend.cs" Link="XInput/XInputBackend.cs" />
  </ItemGroup>
</Project>
